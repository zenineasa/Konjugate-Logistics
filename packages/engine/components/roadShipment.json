{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "roadShipment",
    "kind": "bundle",
    "name": "Road shipment",
    "domains": [
        "logistics"
    ],
    "description": "Moves containers from an origin (a port or a warehouse) through a road lane to a destination warehouse. The destination's orders, times its order share for this lane, queue on the lane; the origin ships them within the order response time, limited by the lane's loading capacity (idle trucks times truck capacity per turnaround) and by the origin's stock. Each shipment takes idle trucks at the origin; they return empty after delivering. Arrivals add to the destination's stock and clear its on-order count. Matched edges keep containers and trucks conserved. Select the origin, the lane and the destination, then click this bundle.",
    "color": "#d98b54",
    "endpoints": [
        {
            "id": "origin",
            "label": "Origin"
        },
        {
            "id": "lane",
            "label": "Road lane"
        },
        {
            "id": "destination",
            "label": "Destination warehouse"
        }
    ],
    "sharedParameters": [
        {
            "key": "orderShare",
            "name": "Order share",
            "symbol": "orderShare",
            "value": 1,
            "unit": "",
            "scope": "instance"
        },
        {
            "key": "responseDays",
            "name": "Order response time",
            "symbol": "responseDays",
            "value": 0.5,
            "unit": "day",
            "scope": "project"
        },
        {
            "key": "originDrainDays",
            "name": "Origin draw-down time",
            "symbol": "originDrainDays",
            "value": 0.5,
            "unit": "day",
            "scope": "project"
        },
        {
            "key": "truckCapacity",
            "name": "Truck capacity",
            "symbol": "truckCapacity",
            "value": 2,
            "unit": "TEU/truck",
            "scope": "project"
        },
        {
            "key": "secondsPerDay",
            "name": "Seconds per day",
            "symbol": "secondsPerDay",
            "value": 86400,
            "unit": "s/day",
            "scope": "project"
        }
    ],
    "edges": [
        {
            "name": "Order",
            "from": "destination",
            "to": "lane",
            "ports": {
                "source": "orderRate",
                "target": "requested"
            },
            "output": {
                "role": "target",
                "state": "requested"
            },
            "latex": "\\frac{\\mathrm{orderShare} \\cdot \\mathrm{sourceOrderRate}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Order share",
                    "symbol": "orderShare",
                    "shared": "orderShare"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "name": "Dispatch",
            "from": "origin",
            "to": "lane",
            "bidirectional": true,
            "ports": {
                "source": "stock",
                "target": [
                    "loaded1",
                    "requested",
                    "canLoad",
                    "idleTrucks"
                ]
            },
            "output": {
                "role": "target",
                "state": "loaded1"
            },
            "latex": "\\frac{\\min(\\frac{\\mathrm{targetRequested}}{\\mathrm{responseDays}}, \\min(\\mathrm{targetCanLoad}, \\frac{\\mathrm{sourceStock}}{\\mathrm{originDrainDays}}))}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Order response time",
                    "symbol": "responseDays",
                    "shared": "responseDays"
                },
                {
                    "name": "Origin draw-down time",
                    "symbol": "originDrainDays",
                    "shared": "originDrainDays"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "name": "Clear orders",
            "from": "origin",
            "to": "lane",
            "ports": {
                "source": "stock",
                "target": [
                    "requested",
                    "canLoad",
                    "idleTrucks"
                ]
            },
            "output": {
                "role": "target",
                "state": "requested"
            },
            "latex": "-\\frac{\\min(\\frac{\\mathrm{targetRequested}}{\\mathrm{responseDays}}, \\min(\\mathrm{targetCanLoad}, \\frac{\\mathrm{sourceStock}}{\\mathrm{originDrainDays}}))}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Order response time",
                    "symbol": "responseDays",
                    "shared": "responseDays"
                },
                {
                    "name": "Origin draw-down time",
                    "symbol": "originDrainDays",
                    "shared": "originDrainDays"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "name": "Take trucks",
            "from": "origin",
            "to": "lane",
            "ports": {
                "source": "stock",
                "target": [
                    "requested",
                    "canLoad",
                    "idleTrucks"
                ]
            },
            "output": {
                "role": "target",
                "state": "idleTrucks"
            },
            "latex": "-\\frac{\\min(\\frac{\\mathrm{targetRequested}}{\\mathrm{responseDays}}, \\min(\\mathrm{targetCanLoad}, \\frac{\\mathrm{sourceStock}}{\\mathrm{originDrainDays}}))}{\\mathrm{truckCapacity} \\cdot \\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Order response time",
                    "symbol": "responseDays",
                    "shared": "responseDays"
                },
                {
                    "name": "Origin draw-down time",
                    "symbol": "originDrainDays",
                    "shared": "originDrainDays"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                },
                {
                    "name": "Truck capacity",
                    "symbol": "truckCapacity",
                    "shared": "truckCapacity"
                }
            ]
        },
        {
            "name": "Arrive",
            "from": "lane",
            "to": "destination",
            "bidirectional": true,
            "ports": {
                "source": [
                    "loaded3",
                    "arriving"
                ],
                "target": "stock"
            },
            "output": {
                "role": "target",
                "state": "stock"
            },
            "latex": "\\frac{\\mathrm{sourceArriving}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "name": "Receive",
            "from": "lane",
            "to": "destination",
            "ports": {
                "source": "arriving",
                "target": "onOrder"
            },
            "output": {
                "role": "target",
                "state": "onOrder"
            },
            "latex": "-\\frac{\\mathrm{sourceArriving}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        }
    ]
}
