    "sourceTerms": [
        {
            "state": "loaded1",
            "expression": "-\\frac{3}{\\mathrm{leadTime} \\cdot \\mathrm{secondsPerDay}} \\cdot \\mathrm{loaded1}",
            "parameters": [
                {
                    "name": "Travel time",
                    "symbol": "leadTime",
                    "shared": "leadTime"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "loaded2",
            "expression": "\\frac{3}{\\mathrm{leadTime} \\cdot \\mathrm{secondsPerDay}} \\cdot (\\mathrm{loaded1} - \\mathrm{loaded2})",
            "parameters": [
                {
                    "name": "Travel time",
                    "symbol": "leadTime",
                    "shared": "leadTime"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "loaded3",
            "expression": "\\frac{3}{\\mathrm{leadTime} \\cdot \\mathrm{secondsPerDay}} \\cdot \\mathrm{loaded2}",
            "parameters": [
                {
                    "name": "Travel time",
                    "symbol": "leadTime",
                    "shared": "leadTime"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "arriving",
            "expression": "\\frac{3 \\cdot \\mathrm{loaded3}}{\\mathrm{leadTime}}",
            "parameters": [
                {
                    "name": "Travel time",
                    "symbol": "leadTime",
                    "shared": "leadTime"
                }
            ],
            "setsValue": true
        },
        {
            "state": "returning",
            "expression": "\\frac{\\frac{\\mathrm{arriving}}{\\mathrm{truckCapacity}} - \\frac{\\mathrm{returning}}{\\mathrm{leadTime}}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Travel time",
                    "symbol": "leadTime",
                    "shared": "leadTime"
                },
                {
                    "name": "Truck capacity",
                    "symbol": "truckCapacity",
                    "shared": "truckCapacity"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "idleTrucks",
            "expression": "\\frac{\\frac{\\mathrm{returning}}{\\mathrm{leadTime}} + \\begin{cases} \\frac{\\mathrm{fleetSize} - (\\frac{\\mathrm{loaded1} + \\mathrm{loaded2} + \\mathrm{loaded3}}{\\mathrm{truckCapacity}} + \\mathrm{returning} + \\mathrm{idleTrucks})}{\\mathrm{hireDays}} & \\frac{\\mathrm{loaded1} + \\mathrm{loaded2} + \\mathrm{loaded3}}{\\mathrm{truckCapacity}} + \\mathrm{returning} + \\mathrm{idleTrucks} < \\mathrm{fleetSize} \\\\ -\\frac{\\min(\\frac{\\mathrm{loaded1} + \\mathrm{loaded2} + \\mathrm{loaded3}}{\\mathrm{truckCapacity}} + \\mathrm{returning} + \\mathrm{idleTrucks} - \\mathrm{fleetSize}, \\mathrm{idleTrucks})}{\\mathrm{hireDays}} & \\text{otherwise} \\end{cases}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Travel time",
                    "symbol": "leadTime",
                    "shared": "leadTime"
                },
                {
                    "name": "Truck capacity",
                    "symbol": "truckCapacity",
                    "shared": "truckCapacity"
                },
                {
                    "name": "Fleet size",
                    "symbol": "fleetSize",
                    "shared": "fleetSize"
                },
                {
                    "name": "Time to hire or release trucks",
                    "symbol": "hireDays",
                    "shared": "hireDays"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "canLoad",
            "expression": "\\frac{\\mathrm{idleTrucks} \\cdot \\mathrm{truckCapacity}}{\\mathrm{loadDays}}",
            "parameters": [
                {
                    "name": "Truck capacity",
                    "symbol": "truckCapacity",
                    "shared": "truckCapacity"
                },
                {
                    "name": "Truck turnaround at origin",
                    "symbol": "loadDays",
                    "shared": "loadDays"
                }
            ],
            "setsValue": true
        },
        {
            "state": "utilisation",
            "expression": "\\frac{\\frac{\\mathrm{loaded1} + \\mathrm{loaded2} + \\mathrm{loaded3}}{\\mathrm{truckCapacity}} + \\mathrm{returning}}{\\frac{\\mathrm{loaded1} + \\mathrm{loaded2} + \\mathrm{loaded3}}{\\mathrm{truckCapacity}} + \\mathrm{returning} + \\mathrm{idleTrucks}}",
            "parameters": [
                {
                    "name": "Truck capacity",
                    "symbol": "truckCapacity",
                    "shared": "truckCapacity"
                }
            ],
            "setsValue": true
        },
        {
            "state": "transportCost",
            "expression": "\\frac{\\mathrm{arriving} \\cdot 2 \\cdot \\mathrm{distance} \\cdot \\mathrm{costPerKm}}{\\mathrm{truckCapacity} \\cdot \\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Distance",
                    "symbol": "distance",
                    "shared": "distance"
                },
                {
                    "name": "Truck cost per km",
                    "symbol": "costPerKm",
                    "shared": "costPerKm"
                },
                {
                    "name": "Truck capacity",
                    "symbol": "truckCapacity",
                    "shared": "truckCapacity"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        }
    ]
