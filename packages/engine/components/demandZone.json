{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "demandZone",
    "kind": "node",
    "name": "Demand zone",
    "domains": [
        "logistics"
    ],
    "description": "A group of customers ordering at a steady rate, with an optional demand step: from the step day on, demand is multiplied by the step multiplier (1 for no step; both are shared by every zone). Orders add to the backlog; Delivery bundles clear it, and drop from it the sales lost when the shelves are short (a store's shoppers who go elsewhere rather than wait). Delivered, lost and ordered are running totals, so backlog always equals its starting value plus ordered minus delivered minus lost, and ordered minus delivered over a period gives the fill rate. Backlog cost accrues per TEU per day waiting. Demand pattern is 1 normally and follows a calendar for a store that keeps hours: nothing while it is closed and more while it is open, so that a week's demand is what it would be. Holidays and peaks is 1 normally and follows the network's calendar of dated events: more before and during a festival, less after, nothing on a day everything is closed.",
    "shape": "sphere",
    "color": "#52727a",
    "states": [
        {
            "symbol": "backlog",
            "label": "Backlog",
            "initialValue": 15,
            "unit": "TEU"
        },
        {
            "symbol": "delivered",
            "label": "Delivered (cumulative)",
            "initialValue": 0,
            "unit": "TEU"
        },
        {
            "symbol": "ordered",
            "label": "Ordered (cumulative)",
            "initialValue": 0,
            "unit": "TEU"
        },
        {
            "symbol": "lost",
            "label": "Sales lost (cumulative)",
            "initialValue": 0,
            "unit": "TEU"
        },
        {
            "symbol": "demandRate",
            "label": "Demand rate",
            "initialValue": 30,
            "unit": "TEU/day"
        },
        {
            "symbol": "backlogCost",
            "label": "Backlog cost",
            "initialValue": 0,
            "unit": "cost"
        }
    ],
    "sharedParameters": [
        {
            "key": "baseDemand",
            "name": "Base demand",
            "symbol": "baseDemand",
            "value": 30,
            "unit": "TEU/day",
            "scope": "instance"
        },
        {
            "key": "demandPattern",
            "name": "Demand pattern",
            "symbol": "demandPattern",
            "value": 1,
            "unit": "",
            "scope": "instance"
        },
        {
            "key": "seasonFactor",
            "name": "Holidays and peaks",
            "symbol": "seasonFactor",
            "value": 1,
            "unit": "",
            "scope": "instance"
        },
        {
            "key": "stepMultiplier",
            "name": "Demand step multiplier",
            "symbol": "stepMultiplier",
            "value": 1,
            "unit": "",
            "scope": "project"
        },
        {
            "key": "stepDay",
            "name": "Demand step day",
            "symbol": "stepDay",
            "value": 20,
            "unit": "day",
            "scope": "project"
        },
        {
            "key": "backlogPenalty",
            "name": "Backlog cost per TEU-day",
            "symbol": "backlogPenalty",
            "value": 5,
            "unit": "cost/TEU/day",
            "scope": "project"
        },
        {
            "key": "secondsPerDay",
            "name": "Seconds per day",
            "symbol": "secondsPerDay",
            "value": 86400,
            "unit": "s/day",
            "scope": "project"
        }
    ],
    "sourceTerms": [
        {
            "state": "demandRate",
            "expression": "\\mathrm{baseDemand} \\cdot \\mathrm{demandPattern} \\cdot \\mathrm{seasonFactor} \\cdot \\begin{cases} \\mathrm{stepMultiplier} & t \\ge \\mathrm{stepDay} \\cdot \\mathrm{secondsPerDay} \\\\ 1 & \\text{otherwise} \\end{cases}",
            "parameters": [
                {
                    "name": "Base demand",
                    "symbol": "baseDemand",
                    "shared": "baseDemand"
                },
                {
                    "name": "Demand step multiplier",
                    "symbol": "stepMultiplier",
                    "shared": "stepMultiplier"
                },
                {
                    "name": "Demand step day",
                    "symbol": "stepDay",
                    "shared": "stepDay"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                },
                {
                    "name": "Demand pattern",
                    "symbol": "demandPattern",
                    "shared": "demandPattern"
                },
                {
                    "name": "Holidays and peaks",
                    "symbol": "seasonFactor",
                    "shared": "seasonFactor"
                }
            ],
            "setsValue": true
        },
        {
            "state": "backlog",
            "expression": "\\frac{\\mathrm{demandRate}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "ordered",
            "expression": "\\frac{\\mathrm{demandRate}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "backlogCost",
            "expression": "\\frac{\\mathrm{backlog} \\cdot \\mathrm{backlogPenalty}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Backlog cost per TEU-day",
                    "symbol": "backlogPenalty",
                    "shared": "backlogPenalty"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        }
    ]
}
