{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "warehouse",
    "kind": "node",
    "name": "Warehouse",
    "domains": [
        "logistics"
    ],
    "description": "A warehouse that replenishes from road and rail lanes. On order counts everything it has ordered and not yet received, across all its inbound lanes, so its order rule is local however many lanes feed it. It forecasts demand by exponential smoothing and orders by an order-up-to rule: the forecast plus a correction towards forecast x (planned replenishment time + stock cover), but only while stock plus on order is below target. The planned replenishment time is the planner's assumption, which may differ from the lanes' real travel times. Holding cost accrues per TEU per day in stock.",
    "shape": "box",
    "color": "#c16f55",
    "states": [
        {
            "symbol": "stock",
            "label": "Stock",
            "initialValue": 210,
            "unit": "TEU"
        },
        {
            "symbol": "onOrder",
            "label": "On order",
            "initialValue": 175,
            "unit": "TEU"
        },
        {
            "symbol": "forecast",
            "label": "Demand forecast",
            "initialValue": 70,
            "unit": "TEU/day"
        },
        {
            "symbol": "orderRate",
            "label": "Order rate",
            "initialValue": 70,
            "unit": "TEU/day"
        },
        {
            "symbol": "holdingCost",
            "label": "Holding cost",
            "initialValue": 0,
            "unit": "cost"
        }
    ],
    "sharedParameters": [
        {
            "key": "planningLeadTime",
            "name": "Planned replenishment time",
            "symbol": "planningLeadTime",
            "value": 2.5,
            "unit": "day",
            "scope": "instance"
        },
        {
            "key": "coverDays",
            "name": "Stock cover target",
            "symbol": "coverDays",
            "value": 3,
            "unit": "day",
            "scope": "project"
        },
        {
            "key": "adjustDays",
            "name": "Inventory adjustment time",
            "symbol": "adjustDays",
            "value": 4,
            "unit": "day",
            "scope": "project"
        },
        {
            "key": "smoothingDays",
            "name": "Demand smoothing time",
            "symbol": "smoothingDays",
            "value": 5,
            "unit": "day",
            "scope": "project"
        },
        {
            "key": "holdingCostPerDay",
            "name": "Holding cost per TEU-day",
            "symbol": "holdingCostPerDay",
            "value": 0.5,
            "unit": "cost/TEU/day",
            "scope": "project"
        },
        {
            "key": "secondsPerDay",
            "name": "Seconds per day",
            "symbol": "secondsPerDay",
            "value": 86400,
            "unit": "s/day",
            "scope": "project"
        }
    ],
    "sourceTerms": [
        {
            "state": "orderRate",
            "expression": "\\begin{cases} \\mathrm{forecast} + \\frac{\\mathrm{forecast} \\cdot (\\mathrm{planningLeadTime} + \\mathrm{coverDays}) - (\\mathrm{stock} + \\mathrm{onOrder})}{\\mathrm{adjustDays}} & \\mathrm{stock} + \\mathrm{onOrder} < \\mathrm{forecast} \\cdot (\\mathrm{planningLeadTime} + \\mathrm{coverDays} + \\mathrm{adjustDays}) \\\\ 0 & \\text{otherwise} \\end{cases}",
            "parameters": [
                {
                    "name": "Planned replenishment time",
                    "symbol": "planningLeadTime",
                    "shared": "planningLeadTime"
                },
                {
                    "name": "Stock cover target",
                    "symbol": "coverDays",
                    "shared": "coverDays"
                },
                {
                    "name": "Inventory adjustment time",
                    "symbol": "adjustDays",
                    "shared": "adjustDays"
                }
            ],
            "setsValue": true
        },
        {
            "state": "onOrder",
            "expression": "\\frac{\\mathrm{orderRate}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "forecast",
            "expression": "-\\frac{\\mathrm{forecast}}{\\mathrm{secondsPerDay} \\cdot \\mathrm{smoothingDays}}",
            "parameters": [
                {
                    "name": "Demand smoothing time",
                    "symbol": "smoothingDays",
                    "shared": "smoothingDays"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "holdingCost",
            "expression": "\\frac{\\mathrm{stock} \\cdot \\mathrm{holdingCostPerDay}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Holding cost per TEU-day",
                    "symbol": "holdingCostPerDay",
                    "shared": "holdingCostPerDay"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        }
    ]
}
