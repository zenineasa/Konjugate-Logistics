    "sourceTerms": [
        {
            "state": "orderRate",
            "expression": "\\max(0, \\mathrm{forecast} + \\frac{\\min(\\mathrm{forecast} \\cdot \\mathrm{planningLeadTime} + \\min(\\mathrm{forecast} \\cdot \\mathrm{coverDays}, \\mathrm{storageCapacity}) - (\\mathrm{stock} + \\mathrm{onOrder}), \\mathrm{storageCapacity} - \\mathrm{stock})}{\\mathrm{adjustDays}})",
            "parameters": [
                {
                    "name": "Planned replenishment time",
                    "symbol": "planningLeadTime",
                    "shared": "planningLeadTime"
                },
                {
                    "name": "Stock cover target",
                    "symbol": "coverDays",
                    "shared": "coverDays"
                },
                {
                    "name": "Storage capacity",
                    "symbol": "storageCapacity",
                    "shared": "storageCapacity"
                },
                {
                    "name": "Inventory adjustment time",
                    "symbol": "adjustDays",
                    "shared": "adjustDays"
                }
            ],
            "setsValue": true
        },
        {
            "state": "forecast",
            "expression": "-\\frac{\\mathrm{forecast}}{\\mathrm{secondsPerDay} \\cdot \\mathrm{smoothingDays}}",
            "parameters": [
                {
                    "name": "Demand smoothing time",
                    "symbol": "smoothingDays",
                    "shared": "smoothingDays"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "holdingCost",
            "expression": "\\frac{\\mathrm{stock} \\cdot \\mathrm{holdingCostPerDay}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Holding cost per TEU-day",
                    "symbol": "holdingCostPerDay",
                    "shared": "holdingCostPerDay"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "state": "spaceUsed",
