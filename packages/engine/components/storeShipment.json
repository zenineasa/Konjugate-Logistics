            "name": "Load trucks",
            "from": "origin",
            "to": "lane",
            "ports": {
                "source": "stock",
                "target": [
                    "requested",
                    "wanted",
                    "canLoad",
                    "idleTrucks",
                    "idleTrucks2"
                ]
            },
            "output": {
                "role": "target",
                "state": "loadedTrucks"
            },
            "latex": "\\frac{\\min(\\frac{\\mathrm{targetWanted}}{\\mathrm{responseDays}}, \\min(\\mathrm{targetCanLoad}, \\frac{\\mathrm{sourceStock}}{\\mathrm{originDrainDays}})) \\cdot (1 - \\begin{cases} \\frac{\\mathrm{targetIdleTrucks2} \\cdot \\mathrm{truckCapacity2}}{\\mathrm{targetIdleTrucks} \\cdot \\mathrm{truckCapacity} + \\mathrm{targetIdleTrucks2} \\cdot \\mathrm{truckCapacity2}} & \\mathrm{targetIdleTrucks} \\cdot \\mathrm{truckCapacity} + \\mathrm{targetIdleTrucks2} \\cdot \\mathrm{truckCapacity2} > 0 \\\\ 0 & \\text{otherwise} \\end{cases})}{\\mathrm{truckCapacity} \\cdot \\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Order response time",
                    "symbol": "responseDays",
                    "shared": "responseDays"
                },
                {
                    "name": "Origin draw-down time",
                    "symbol": "originDrainDays",
                    "shared": "originDrainDays"
                },
                {
                    "name": "Truck capacity",
                    "symbol": "truckCapacity",
                    "shared": "truckCapacity"
                },
                {
                    "name": "Truck capacity, second size",
                    "symbol": "truckCapacity2",
                    "shared": "truckCapacity2"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "name": "Take trucks, second size",
            "from": "origin",
            "to": "lane",
            "ports": {
                "source": "stock",
                "target": [
                    "requested",
                    "wanted",
                    "canLoad",
                    "idleTrucks",
                    "idleTrucks2"
                ]
            },
            "output": {
                "role": "target",
                "state": "idleTrucks2"
            },
            "latex": "-\\frac{\\min(\\frac{\\mathrm{targetWanted}}{\\mathrm{responseDays}}, \\min(\\mathrm{targetCanLoad}, \\frac{\\mathrm{sourceStock}}{\\mathrm{originDrainDays}})) \\cdot \\begin{cases} \\frac{\\mathrm{targetIdleTrucks2} \\cdot \\mathrm{truckCapacity2}}{\\mathrm{targetIdleTrucks} \\cdot \\mathrm{truckCapacity} + \\mathrm{targetIdleTrucks2} \\cdot \\mathrm{truckCapacity2}} & \\mathrm{targetIdleTrucks} \\cdot \\mathrm{truckCapacity} + \\mathrm{targetIdleTrucks2} \\cdot \\mathrm{truckCapacity2} > 0 \\\\ 0 & \\text{otherwise} \\end{cases}}{\\mathrm{truckCapacity2} \\cdot \\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Order response time",
                    "symbol": "responseDays",
                    "shared": "responseDays"
                },
                {
                    "name": "Origin draw-down time",
                    "symbol": "originDrainDays",
                    "shared": "originDrainDays"
                },
                {
                    "name": "Truck capacity",
                    "symbol": "truckCapacity",
                    "shared": "truckCapacity"
                },
                {
                    "name": "Truck capacity, second size",
                    "symbol": "truckCapacity2",
                    "shared": "truckCapacity2"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "name": "Load trucks, second size",
            "from": "origin",
            "to": "lane",
            "ports": {
                "source": "stock",
                "target": [
                    "requested",
                    "wanted",
                    "canLoad",
                    "idleTrucks",
                    "idleTrucks2"
                ]
            },
            "output": {
                "role": "target",
                "state": "loadedTrucks2"
            },
            "latex": "\\frac{\\min(\\frac{\\mathrm{targetWanted}}{\\mathrm{responseDays}}, \\min(\\mathrm{targetCanLoad}, \\frac{\\mathrm{sourceStock}}{\\mathrm{originDrainDays}})) \\cdot \\begin{cases} \\frac{\\mathrm{targetIdleTrucks2} \\cdot \\mathrm{truckCapacity2}}{\\mathrm{targetIdleTrucks} \\cdot \\mathrm{truckCapacity} + \\mathrm{targetIdleTrucks2} \\cdot \\mathrm{truckCapacity2}} & \\mathrm{targetIdleTrucks} \\cdot \\mathrm{truckCapacity} + \\mathrm{targetIdleTrucks2} \\cdot \\mathrm{truckCapacity2} > 0 \\\\ 0 & \\text{otherwise} \\end{cases}}{\\mathrm{truckCapacity2} \\cdot \\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Order response time",
                    "symbol": "responseDays",
                    "shared": "responseDays"
                },
                {
                    "name": "Origin draw-down time",
                    "symbol": "originDrainDays",
                    "shared": "originDrainDays"
                },
                {
                    "name": "Truck capacity",
                    "symbol": "truckCapacity",
                    "shared": "truckCapacity"
                },
                {
                    "name": "Truck capacity, second size",
                    "symbol": "truckCapacity2",
                    "shared": "truckCapacity2"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "name": "Arrive",
            "from": "lane",
            "to": "destination",
            "bidirectional": true,
            "ports": {
                "source": [
                    "loaded3",
                    "arriving"
                ],
                "target": "stock"
            },
            "output": {
                "role": "target",
                "state": "stock"
            },
            "latex": "\\frac{\\mathrm{sourceArriving}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "name": "Receive",
            "from": "lane",
            "to": "destination",
            "ports": {
                "source": "arriving",
                "target": "onOrder"
            },
            "output": {
                "role": "target",
                "state": "onOrder"
            },
            "latex": "-\\frac{\\mathrm{sourceArriving}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        },
        {
            "name": "Order signal",
            "from": "destination",
            "to": "origin",
            "ports": {
                "source": "orderRate",
                "target": "forecast"
            },
            "output": {
                "role": "target",
                "state": "forecast"
            },
            "latex": "\\frac{\\mathrm{orderShare} \\cdot \\mathrm{sourceOrderRate}}{\\mathrm{secondsPerDay} \\cdot \\mathrm{smoothingDays}}",
            "parameters": [
                {
                    "name": "Order share",
                    "symbol": "orderShare",
                    "shared": "orderShare"
                },
                {
                    "name": "Demand smoothing time",
                    "symbol": "smoothingDays",
