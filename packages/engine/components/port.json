    "color": "#2e7591",
    "states": [
        {
            "symbol": "yard",
            "label": "Yard stock",
            "initialValue": 300,
            "unit": "TEU"
        }
    ],
    "sharedParameters": [
        {
            "key": "vesselArrivals",
            "name": "Vessel arrivals",
            "symbol": "vesselArrivals",
            "value": 100,
            "unit": "TEU/day",
            "scope": "instance"
        },
        {
            "key": "secondsPerDay",
            "name": "Seconds per day",
            "symbol": "secondsPerDay",
            "value": 86400,
            "unit": "s/day",
            "scope": "project"
        }
    ],
    "sourceTerms": [
        {
            "state": "yard",
            "expression": "\\frac{\\mathrm{vesselArrivals}}{\\mathrm{secondsPerDay}}",
            "parameters": [
                {
                    "name": "Vessel arrivals",
                    "symbol": "vesselArrivals",
                    "shared": "vesselArrivals"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        }
    ]
