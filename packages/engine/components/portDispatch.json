{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "portDispatch",
    "kind": "bundle",
    "name": "Port dispatch",
    "domains": [
        "logistics"
    ],
    "description": "Releases containers from a port's yard into a warehouse's inbound lane at the warehouse's order rate, limited by this lane's share of the gate capacity and by what is in the yard. During the outage window (outage start <= day < outage end) the gate runs at its outage capacity instead. What leaves the yard enters the lane, so containers are conserved. Gate capacity and the outage window are shared by every lane; the gate share is per lane. Select the port and the warehouse, then click this bundle.",
    "color": "#d98b54",
    "endpoints": [
        {
            "id": "port",
            "label": "Port"
        },
        {
            "id": "warehouse",
            "label": "Warehouse"
        }
    ],
    "sharedParameters": [
        {
            "key": "gateShare",
            "name": "Gate share",
            "symbol": "gateShare",
            "value": 1,
            "unit": "",
            "scope": "instance"
        },
        {
            "key": "gateCapacity",
            "name": "Gate capacity",
            "symbol": "gateCapacity",
            "value": 150,
            "unit": "TEU/day",
            "scope": "project"
        },
        {
            "key": "outageCapacity",
            "name": "Gate capacity during outage",
            "symbol": "outageCapacity",
            "value": 150,
            "unit": "TEU/day",
            "scope": "project"
        },
        {
            "key": "outageStart",
            "name": "Outage start",
            "symbol": "outageStart",
            "value": 20,
            "unit": "day",
            "scope": "project"
        },
        {
            "key": "outageEnd",
            "name": "Outage end",
            "symbol": "outageEnd",
            "value": 50,
            "unit": "day",
            "scope": "project"
        },
        {
            "key": "yardDrainDays",
            "name": "Yard drain time",
            "symbol": "yardDrainDays",
            "value": 0.5,
            "unit": "day",
            "scope": "project"
        },
        {
            "key": "secondsPerDay",
            "name": "Seconds per day",
            "symbol": "secondsPerDay",
            "value": 86400,
            "unit": "s/day",
            "scope": "project"
        }
    ],
    "edges": [
        {
            "name": "Dispatch",
            "from": "port",
            "to": "warehouse",
            "bidirectional": true,
            "ports": {
                "source": "yard",
                "target": [
                    "lane1",
                    "orderRate"
                ]
            },
            "output": {
                "role": "target",
                "state": "lane1"
            },
            "latex": "\\frac{1}{\\mathrm{secondsPerDay}} \\cdot \\min(\\mathrm{targetOrderRate}, \\min(\\mathrm{gateShare} \\cdot \\begin{cases} \\mathrm{outageCapacity} & \\mathrm{outageStart} \\cdot \\mathrm{secondsPerDay} \\le t < \\mathrm{outageEnd} \\cdot \\mathrm{secondsPerDay} \\\\ \\mathrm{gateCapacity} & \\text{otherwise} \\end{cases}, \\frac{\\mathrm{gateShare} \\cdot \\mathrm{sourceYard}}{\\mathrm{yardDrainDays}}))",
            "parameters": [
                {
                    "name": "Gate share",
                    "symbol": "gateShare",
                    "shared": "gateShare"
                },
                {
                    "name": "Gate capacity",
                    "symbol": "gateCapacity",
                    "shared": "gateCapacity"
                },
                {
                    "name": "Gate capacity during outage",
                    "symbol": "outageCapacity",
                    "shared": "outageCapacity"
                },
                {
                    "name": "Outage start",
                    "symbol": "outageStart",
                    "shared": "outageStart"
                },
                {
                    "name": "Outage end",
                    "symbol": "outageEnd",
                    "shared": "outageEnd"
                },
                {
                    "name": "Yard drain time",
                    "symbol": "yardDrainDays",
                    "shared": "yardDrainDays"
                },
                {
                    "name": "Seconds per day",
                    "symbol": "secondsPerDay",
                    "shared": "secondsPerDay"
                }
            ]
        }
    ]
}
